#!/usr/bin/env bash

set -e

REPO_URL="https://github.com/adxthya/mac-dotfiles"
DOTFILES_DIR="$HOME/mac-dotfiles"

# Create ~/.config if it doesn't exist
if [ -d "$HOME/.config" ]; then
  echo "Directory $HOME/.config already exists."
else
  mkdir -p "$HOME/.config"
  echo "Directory $HOME/.config created."
fi

# Clone repo if not already cloned
if [ -d "$DOTFILES_DIR" ]; then
  echo "mac-dotfiles already exists. Skipping clone."
else
  echo "Cloning mac-dotfiles..."
  git clone "$REPO_URL" "$DOTFILES_DIR"
fi

# Run stow
echo "Running stow..."
cd "$DOTFILES_DIR" || exit 1
stow .
